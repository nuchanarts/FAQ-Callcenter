# file (default in development, local JSON in .data/) | memory (tests) | failing (no-DB test) | supabase
# | sheets (FAQ + admin accounts in the Google Sheet via the Apps Script; needs SHEET_WEBHOOK_*)
# Required in production.
DATA_BACKEND=file

# Required in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase (only when DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheet logging (reports + topic views). Optional: unset = logging off.
# Setup: scripts/google-sheet-webhook.gs (Apps Script web app URL + its SECRET script property).
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Manual library ("คู่มือ" page) content: Google Sheet id (shared "anyone with the link can view").
# Unset = built-in copy. Tabs: news, datacheck, onepage, videos, links.
MANUALS_SHEET_ID=

# Staff sign-in with Google (required for the admin area in production).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application),
# Authorized JavaScript origins: your site URL (+ http://localhost:3000). Not a secret.
GOOGLE_CLIENT_ID=
