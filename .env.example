# file (default in development, local JSON in .data/) | memory (tests) | failing (no-DB test) | supabase
# Required in production.
DATA_BACKEND=file

# Required in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase (only when DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
